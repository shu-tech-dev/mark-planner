{
  "name": "mark-planner",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markPlanner.openCalendar",
        "title": "%command.openCalendar%",
        "category": "Mark Planner"
      },
      {
        "command": "markPlanner.openGantt",
        "title": "%command.openGantt%",
        "category": "Mark Planner"
      },
      {
        "command": "markPlanner.openSettings",
        "title": "%command.openSettings%",
        "category": "Mark Planner"
      },
      {
        "command": "markPlanner.newItem",
        "title": "%command.newItem%",
        "category": "Mark Planner"
      },
      {
        "command": "markPlanner.fixDuplicateIds",
        "title": "%command.fixDuplicateIds%",
        "category": "Mark Planner"
      }
    ],
    "configuration": {
      "title": "Mark Planner",
      "properties": {
        "markPlanner.include": {
          "type": "string",
          "default": "**/*.md",
          "description": "%config.include%",
          "order": 0
        },
        "markPlanner.exclude": {
          "type": "string",
          "default": "**/node_modules/**",
          "description": "%config.exclude%",
          "order": 1
        },
        "markPlanner.newItemFolder": {
          "type": "string",
          "default": "planner",
          "description": "%config.newItemFolder%",
          "order": 2
        },
        "markPlanner.template.body": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "%config.template.body%",
          "order": 3
        },
        "markPlanner.template.frontmatter": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.template.frontmatter%",
          "order": 4
        },
        "markPlanner.properties": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.properties%",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "tags": {
              "type": "string"
            },
            "parent": {
              "type": "string"
            },
            "depends": {
              "type": "string"
            }
          },
          "order": 5
        },
        "markPlanner.statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "color"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "%config.statuses.name%"
              },
              "label": {
                "type": "string",
                "description": "%config.statuses.label%"
              },
              "color": {
                "type": "string",
                "format": "color",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "%config.statuses.color%"
              },
              "progress": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "%config.statuses.progress%"
              },
              "done": {
                "type": "boolean",
                "description": "%config.statuses.done%"
              }
            }
          },
          "markdownDescription": "%config.statuses%",
          "order": 6,
          "default": [
            {
              "name": "todo",
              "color": "#3794ff",
              "progress": 0,
              "done": false
            },
            {
              "name": "doing",
              "color": "#d18616",
              "progress": 50,
              "done": false
            },
            {
              "name": "done",
              "color": "#888888",
              "progress": 100,
              "done": true
            }
          ]
        },
        "markPlanner.eventColor": {
          "type": "string",
          "format": "color",
          "default": "#b180d7",
          "description": "%config.eventColor%",
          "order": 7
        },
        "markPlanner.calendarView": {
          "type": "string",
          "enum": [
            "month",
            "week",
            "day"
          ],
          "default": "month",
          "description": "%config.calendarView%",
          "order": 8
        },
        "markPlanner.weekStart": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "default": 0,
          "description": "%config.weekStart%",
          "enumItemLabels": [
            "%weekday.0%",
            "%weekday.1%",
            "%weekday.2%",
            "%weekday.3%",
            "%weekday.4%",
            "%weekday.5%",
            "%weekday.6%"
          ],
          "order": 9
        },
        "markPlanner.ganttViewMode": {
          "type": "string",
          "enum": [
            "Day",
            "Week",
            "Month"
          ],
          "default": "Day",
          "description": "%config.ganttViewMode%",
          "order": 10
        },
        "markPlanner.hideDone": {
          "type": "boolean",
          "default": false,
          "description": "%config.hideDone%",
          "order": 11
        },
        "markPlanner.weekendDays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "default": [
            0,
            6
          ],
          "uniqueItems": true,
          "description": "%config.weekendDays%",
          "order": 12
        },
        "markPlanner.showHolidays": {
          "type": "boolean",
          "default": true,
          "description": "%config.showHolidays%",
          "order": 13
        },
        "markPlanner.holidayColor": {
          "type": "string",
          "format": "color",
          "default": "#f14c4c",
          "description": "%config.holidayColor%",
          "order": 14
        },
        "markPlanner.vacationColor": {
          "type": "string",
          "format": "color",
          "default": "#2ea043",
          "description": "%config.vacationColor%",
          "order": 15
        },
        "markPlanner.language": {
          "type": "string",
          "enum": [
            "auto",
            "ja",
            "en"
          ],
          "default": "auto",
          "description": "%config.language%",
          "enumDescriptions": [
            "%config.language.auto%",
            "日本語",
            "English"
          ],
          "order": 16
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node build.mjs --production",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node build.mjs --integration && tsx test/integration/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@holiday-jp/holiday_jp": "^2.5.2",
    "frappe-gantt": "^1.2.2",
    "yaml": "^2.9.1"
  }
}
